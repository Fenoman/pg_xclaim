default_version = '1.0.0-rc3'
module_pathname = '$libdir/pg_xclaim'
relocatable = false
schema = xclaim
requires = ''
trusted = false
superuser = true
# Note: xclaim.* calls raise an ERROR on a hot standby until it is
# promoted. Keep pg_xclaim in shared_preload_libraries on replicas, so a
# promoted standby serves claims without a restart.
